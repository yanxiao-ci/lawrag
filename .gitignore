# IDE
.idea

# Python 缓存
__pycache__/
*.pyc

# 大模型权重（体积过大，不入库）
/**/models
/**/core/bert_results

# 法律方向大体积数据（评测集/层级语料，体积过大不入库；主语料 law_data 正常入库）
/rag_qa/data/law_eval/
/rag_qa/data/law_chapter/

# 全量法规原始数据（152MB，扩容脚本的数据源，不入库）
/_law_src/

# 语料扩容时自动生成的旧语料备份（不入库）
/rag_qa/data/_backup_law_data_*/

# 早期文件（旧入口 / 旧前端 / 旧语料 / 旧评测集）：已归到此目录，不入库
/_archive/

# 日志
/**/*.log

# 本地环境变量（含 API Key，禁止入库）
.env

# 个人简历 / 面试准备用的项目展示页（留在本机，不进公开仓库）
/docs/项目展示.html
/docs/index.html
